{
  "name": "world-game-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/generate-precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "android:prepare": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
